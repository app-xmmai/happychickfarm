{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?:.*\\.vercel\\.app|www\\.xmm-ai\\.com)"
        }
      ],
      "destination": "https://xmm-ai.com/$1",
      "permanent": false
    },
    {
      "source": "/terms.html",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/chat",
      "destination": "https://app.xmm-ai.com/",
      "permanent": false
    },
    {
      "source": "/chat/",
      "destination": "https://app.xmm-ai.com/",
      "permanent": false
    },
    {
      "source": "/chat/index.html",
      "destination": "https://app.xmm-ai.com/",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "https://auth.xmm-ai.com/",
      "permanent": false
    },
    {
      "source": "/login/",
      "destination": "https://auth.xmm-ai.com/",
      "permanent": false
    },
    {
      "source": "/login/index.html",
      "destination": "https://auth.xmm-ai.com/",
      "permanent": false
    },
    {
      "source": "/support",
      "destination": "https://support.xmm-ai.com/",
      "permanent": false
    },
    {
      "source": "/support/",
      "destination": "https://support.xmm-ai.com/",
      "permanent": false
    },
    {
      "source": "/support/index.html",
      "destination": "https://support.xmm-ai.com/",
      "permanent": false
    },
    {
      "source": "/status",
      "destination": "https://status.xmm-ai.com/",
      "permanent": false
    },
    {
      "source": "/status/",
      "destination": "https://status.xmm-ai.com/",
      "permanent": false
    },
    {
      "source": "/status/index.html",
      "destination": "https://status.xmm-ai.com/",
      "permanent": false
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/home/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/home/index.html",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "app\\.xmm-ai\\.com"
        }
      ],
      "destination": "/chat/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "auth\\.xmm-ai\\.com"
        }
      ],
      "destination": "/login/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "support\\.xmm-ai\\.com"
        }
      ],
      "destination": "/support/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "status\\.xmm-ai\\.com"
        }
      ],
      "destination": "/status/index.html"
    },
    {
      "source": "/",
      "destination": "/home/index.html"
    },
    {
      "source": "/map/(.*)",
      "destination": "/chat/index.html"
    }
  ]
}